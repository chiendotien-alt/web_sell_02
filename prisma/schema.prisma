// Prisma schema — dùng PostgreSQL (ví dụ database miễn phí từ Neon).
// Xem hướng dẫn lấy DATABASE_URL trong README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Int // đơn vị: VNĐ
  compareAt   Int? // giá gạch ngang (nếu có khuyến mãi)
  imageUrl    String
  stock       Int      @default(0)
  category    String   @default("Khác")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Conversation {
  id        String    @id @default(cuid())
  visitorId String // id ẩn danh lưu ở trình duyệt khách (localStorage)
  createdAt DateTime  @default(now())
  messages  ChatMessage[]
  orders    Order[]
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
}

model Order {
  id             String        @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  customerName   String
  phone          String
  address        String
  note           String?
  paymentMethod  String        @default("COD") // COD | VNPAY
  paymentStatus  String        @default("PENDING") // PENDING | PAID
  status         String        @default("NEW") // NEW | CONFIRMED | SHIPPING | DONE | CANCELLED
  total          Int
  items          OrderItem[]
  createdAt      DateTime      @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // giá tại thời điểm đặt hàng
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}
